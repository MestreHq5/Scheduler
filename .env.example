# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings -> API -> service_role key.
# Server-only. Used by the .ics sync Edge Function / any admin-level route.
# NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar API (separate from Supabase's Google *login* OAuth client
# below — this one needs the Calendar scope). Only required once Google
# Calendar import/export is wired up.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
