# Required — from your Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — only needed if you want to run the SQL files in
# supabase/migrations/ from your terminal instead of pasting them into
# Supabase's own SQL Editor. From Settings -> Database -> Connection string.
# Server-only. NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_DB_URL=

# Optional — not used by the app itself today. From Settings -> API ->
# service_role. Server-only, keep secret. NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
